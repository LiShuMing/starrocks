WHERE (`d_grab_area_summary`.`layer` = 'City') AND (`d_grab_area_summary`.`purposes` = 'Generic')) , `t` (`area_id`, `area_name`, `purposes`, `layer`) AS (SELECT `d_grab_area_summary`.`area_id`, `d_grab_area_summary`.`area_name`, `d_grab_area_summary`.`purposes`, `d_grab_area_summary`.`layer`
