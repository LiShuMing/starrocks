CREATE TABLE `d_grab_area_summary` (
    `area_id` VARCHAR(255),
    `area_name` VARCHAR(255),
    `layer` VARCHAR(50),
    `purposes` VARCHAR(50),
    `city_id` INT,
    `parent_territory` VARCHAR(255),
    `parent_region` VARCHAR(255),
    `geohash` VARCHAR(12),
    `is_active` BOOLEAN,
    `created_at` DATETIME,
    `updated_at` DATETIME
