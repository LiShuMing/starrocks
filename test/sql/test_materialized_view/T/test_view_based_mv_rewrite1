SELECT
    generic_region_name,
    CAST(SUM((COALESCE(gross_merchandise_value, 0) * 1.00) / dax_fare) AS DOUBLE) AS transport_gmv_lrpar_usd_rrpar
FROM
    v_f_transport_metrics AS fact_data_source
LEFT JOIN (
    SELECT
        city_id,
        max(generic_region_name) AS generic_region_name
    FROM
        v_grab_area_above_city
    GROUP BY
        1) AS above_city 
    ON above_city.city_id = fact_data_source.city_id
WHERE
    DATE_TRUNC('day', created_at_local) >= STR_TO_DATE('2020-07-28 00:00:00', '%Y-%m-%d %H:%i:%S')
    AND DATE_TRUNC('day', created_at_local) < STR_TO_DATE('2025-08-02 00:00:00', '%Y-%m-%d %H:%i:%S')
    AND date_id >= 20200726
    AND date_id < 20250804
GROUP BY 1
ORDER BY 1;

