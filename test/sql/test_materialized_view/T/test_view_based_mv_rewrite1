CREATE VIEW `v_grab_area_above_city` (`city_id`, `generic_territory_id`, `generic_territory_name`, `generic_region_id`, `generic_region_name`) AS WITH `c` (`city_id`, `purposes`, `parent_territory`, `parent_region`) AS (SELECT `d_grab_area_summary`.`city_id`, `d_grab_area_summary`.`purposes`, `d_grab_area_summary`.`parent_territory`, `d_grab_area_summary`.`parent_region`
